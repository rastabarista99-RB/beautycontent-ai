generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String                 @id @default(uuid()) @db.Uuid
  email        String                 @unique
  passwordHash String                 @map("password_hash")
  name         String?
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  business     Business?
  projects     Project[]
  dailyUsage   GenerationDailyUsage[]

  @@map("users")
}

model Business {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  name             String
  industry         String    @default("beauty_salon")
  city             String?
  description      String?
  targetAudience   String?   @map("target_audience")
  toneOfVoice      String?   @map("tone_of_voice")
  brandDescription String?   @map("brand_description")
  brandAdvantages  String?   @map("brand_advantages")
  preferredPhrases String?   @map("preferred_phrases")
  forbiddenPhrases String?   @map("forbidden_phrases")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  services         Service[]
  projects         Project[]

  @@unique([id, userId])
  @@map("businesses")
}

model Service {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  name        String
  description String?
  price       Decimal? @db.Decimal(12, 2)
  currency    String   @default("MDL")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("services")
}

model Project {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  businessId  String       @map("business_id") @db.Uuid
  type        String
  goal        String
  title       String?
  prompt      String?
  content     String?
  status      String       @default("saved")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business     @relation(fields: [businessId, userId], references: [id, userId], onDelete: Cascade)
  generations Generation[]

  @@index([userId, updatedAt(sort: Desc), createdAt(sort: Desc)])
  @@map("projects")
}

model Generation {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  model        String?
  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("generations")
}

model GenerationDailyUsage {
  userId       String   @map("user_id") @db.Uuid
  usageDateUtc DateTime @map("usage_date_utc") @db.Date
  attempts     Int      @default(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, usageDateUtc])
  @@map("generation_daily_usage")
}
